<% content_for :page_title do %>
  <%= Spree.t(:address_autocomplete_heading, scope: :address_autocomplete) %>
<% end %>

<%= form_with(model: @address_autocomplete, url: admin_address_autocomplete_path, method: :put, local: true) do |f| %>
  <div class="row">
    <div class="col-6">
      <%= f.field_container :api_key do %>
        <%= f.label :api_key, Spree.t(:api_key, scope: :address_autocomplete) %>
        <%= f.text_field :api_key, class: 'form-control mt-2' %>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col mt-3">
      <div class="form-actions">
        <%= f.button Spree.t('actions.update'), class: 'btn btn-primary' %>
      </div>
    </div>
  </div>
<% end %>
